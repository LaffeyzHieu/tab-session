{
  "manifest_version": 3,
  "name": "Tab Time Limiter",
  "version": "2.0.0",
  "description": "Track active time on distracting sites",

  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "windows"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.youtube.com/*",
        "*://*.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["img/*.png"],
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.youtube.com/*",
        "*://*.facebook.com/*"
      ]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Time Limiter"
  }
}